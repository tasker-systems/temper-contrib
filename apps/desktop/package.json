		"tauri": "tauri",
		"test": "vitest run",
		"guard:colours": "node scripts/check-no-literal-colours.mjs",
		"lint": "biome ci .",
		"lint:fix": "biome check --write ."
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-markdown": "^6",
