		"@testing-library/svelte": "^5.4.2",
		"jsdom": "^30.1.1",
		"playwright-core": "^1.63.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^5.0.2"
